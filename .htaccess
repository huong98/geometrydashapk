RewriteEngine On

RewriteCond %{REQUEST_URI} ^/Home\.html$ [NC]
RewriteRule ^(.*)$ https://geometrydashapk.games/ [R=301,L]

# Normalize legacy Blog URLs before Apache resolves the /Blog asset directory.
RewriteCond %{THE_REQUEST} \s/+Blog\.html(?:[/?\s]|$) [NC]
RewriteRule ^Blog\.html/?(.*)$ /blog/$1 [R=301,L,NE]

RewriteRule ^Blog/?$ /blog [R=301,L]

# Language-prefixed URLs, e.g. /vn, /jp, /de/blog, /fr/blog/post-slug.
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/(Home|Android|IOS|Windows|Blog|assets|About-Us_files|Contact-Us_files|Disclaimer_files|Privacy-Policy_files|Terms-and-Conditions_files)/(.*)$ /$2/$3 [L]

RewriteCond %{DOCUMENT_ROOT}/Blog/$2.html -f
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/blog/([^/]+)/?$ /Blog/$2.html [L]

RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/blog/?$ /blog.html [L]
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/android/?$ /Android.html [L]
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/ios/?$ /IOS.html [L]
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/window/?$ /Window.html [L]
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/(Android|IOS|Window|about|contact|privacy-policy|disclaimer|terms-and-conditions)/?$ /$2.html [L]
RewriteRule ^(vn|jp|kr|cn|tw|es|fr|de|it|nl|pt|se|dk|no|fi|id|th|my|pl|tr|ru|ua|in|bd|pk|ir|sa|il|cz|ro|hu|gr)/?$ /index.html [L]

# Serve generated blog posts from the /Blog directory for clean /blog/slug URLs.
RewriteCond %{DOCUMENT_ROOT}/Blog/$1.html -f
RewriteRule ^blog/([^/]+)/?$ /Blog/$1.html [L]

# Redirect direct .html page requests to extensionless URLs.
# Only match the URL path, not query strings such as admin.php?edit_page=404.html.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html(?:[?\s]|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve matching .html files for extensionless URLs, e.g. /blog -> blog.html.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /404.html
